{
  "name": "quire",
  "version": "0.1.0",
  "private": true,
  "description": "Export Figma sections as ordered, merged, compressed PDFs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "node scripts/preview.mjs",
    "assets": "node scripts/assets.mjs",
    "inspect": "node scripts/inspect-pdf.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.2",
    "@types/node": "^20.17.6",
    "esbuild": "^0.24.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
